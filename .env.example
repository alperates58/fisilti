# ==========================================
# FISILTI - ÇEVRE DEĞİŞKENLERİ ŞABLONU (.env)
# ==========================================

# Ortam ve Portlar
ENVIRONMENT=development
PORT=8080
FRONTEND_PORT=3002
FRONTEND_URL=http://localhost:3002

# PostgreSQL 16
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=fisilti_user
POSTGRES_PASSWORD=fisilti_secure_pass_2026
POSTGRES_DB=fisilti
DATABASE_URL=postgres://fisilti_user:fisilti_secure_pass_2026@postgres:5432/fisilti?sslmode=disable

# Redis 7
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_ADDR=redis:6379

# MinIO S3 Nesne Depolama
MINIO_ROOT_USER=fisilti_admin
MINIO_ROOT_PASSWORD=fisilti_minio_secret_2026
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_USE_SSL=false
MINIO_BUCKET_AVATARS=avatars
MINIO_BUCKET_VOICE=audio-messages
MINIO_BUCKET_MEDIA=media
MINIO_BUCKET_FILES=files

# LiveKit SFU (WebRTC Sesli & Görüntülü Arama)
LIVEKIT_URL=http://livekit:7880
LIVEKIT_PUBLIC_URL=http://localhost:7880
LIVEKIT_API_KEY=API_KEY_FISILTI
LIVEKIT_API_SECRET=SECRET_KEY_SUPER_SECURE_FISILTI_2026

# JWT & Oturum Güvenliği
JWT_ACCESS_SECRET=fisilti_jwt_access_secret_super_key_32bytes_long
JWT_REFRESH_SECRET=fisilti_jwt_refresh_secret_super_key_32bytes_long
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=30

# Frontend Next.js Public Değişkenleri
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
NEXT_PUBLIC_LIVEKIT_URL=http://localhost:7880
